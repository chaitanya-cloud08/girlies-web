# From Supabase → Project Settings → API (or "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Only used by `npm run seed` on your own computer. Never put this on Vercel.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Logins created by the seed script
SEED_ADMIN_PASSWORD=change-me
SEED_SHRUTI_EMAIL=someone@example.com
SEED_SHRUTI_PASSWORD=change-me
SEED_JASBIR_EMAIL=someone@example.com
SEED_JASBIR_PASSWORD=change-me
SEED_PRANJALI_EMAIL=someone@example.com
SEED_PRANJALI_PASSWORD=change-me
